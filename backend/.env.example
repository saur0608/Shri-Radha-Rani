# Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://saurabhsingh@localhost:5433/radha_rani_db?schema=public

# JWT Authentication
JWT_SECRET=super-secret-radha-rani-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-signing-key

# OTP Security & Verification Rules
OTP_SECRET=super-secret-radha-rani-otp-hmac-salt-key-min-32-chars
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=30
OTP_HOURLY_LIMIT=5
OTP_LOG_CONSOLE=true

# SMS Provider Configuration ('console' | 'fast2sms' | 'twilio')
# Set to 'console' for local development or testing (prints OTP in terminal)
SMS_PROVIDER=console
# Fast2SMS (Indian DLT-compliant SMS)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=RADHAR
FAST2SMS_DLT_TEMPLATE_ID=1107161234567890123
# Twilio (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Provider Configuration ('console' | 'nodemailer' | 'resend')
EMAIL_PROVIDER=console
# Nodemailer (SMTP: Gmail, Amazon SES, Brevo, SendGrid, Hostinger)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Shri Radha Rani Shringar" <support@shriradharanishringar.com>
# Resend (Alternative)
RESEND_API_KEY=re_your_resend_api_key

# Razorpay Test / Live Keys (Never expose secrets in frontend!)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
RAZORPAY_WEBHOOK_SECRET=YourRazorpayWebhookSecretHere

# Cloudinary (Image Storage for Products)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Store Business Details
STORE_NAME=Shri Radha Rani Shringar
STORE_PHONE=+919876543210
STORE_EMAIL=support@shriradharanishringar.com
FREE_SHIPPING_THRESHOLD=999
STANDARD_SHIPPING_FEE=70
COD_AVAILABLE=true
