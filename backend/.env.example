# Server Configuration
PORT=5001
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:3000

# Database (PostgreSQL with Prisma)
DATABASE_URL=postgresql://saurabhsingh@localhost:5433/radha_rani_db?schema=public

# JWT Authentication
JWT_SECRET=super-secret-radha-rani-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super-secret-cookie-signing-key

# OTP Security & Verification Rules
OTP_SECRET=super-secret-radha-rani-otp-hmac-salt-key-min-32-chars
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=30
OTP_HOURLY_LIMIT=5
OTP_DEV_MODE=true
OTP_LOG_CONSOLE=true

# SMS Provider Configuration ('console' | 'fast2sms' | 'twilio' | 'msg91')
# Set to 'console' or OTP_DEV_MODE=true for local testing without sending real SMS
SMS_PROVIDER=console
# Fast2SMS (Indian DLT or Quick OTP route)
FAST2SMS_API_KEY=your_fast2sms_api_key_here
FAST2SMS_SENDER_ID=RADHAR
FAST2SMS_DLT_TEMPLATE_ID=1107161234567890123
FAST2SMS_ENTITY_ID=your_dlt_entity_id
# MSG91 (Alternative)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_flow_or_template_id
# Twilio (Alternative)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Email Provider Configuration ('console' | 'nodemailer' | 'resend')
